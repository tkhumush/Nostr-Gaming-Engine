{
  "name": "nostr-gaming-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Platform for building P2P turn-based games on Nostr with Lightning payments",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nostr-gaming-engine/scrabble dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @nostr-gaming-engine/core build",
    "build:scrabble": "pnpm --filter @nostr-gaming-engine/scrabble build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf packages/*/dist examples/*/dist node_modules/.cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkhumush/Nostr-Gaming-Engine.git"
  },
  "keywords": [
    "nostr",
    "gaming",
    "lightning",
    "p2p",
    "turn-based"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tkhumush/Nostr-Gaming-Engine/issues"
  },
  "homepage": "https://github.com/tkhumush/Nostr-Gaming-Engine#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
